{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-*.json",
      "**/.*",
      "**/node_modules/**",
      "apps-script/**",
      "src*.html",
      "index-v4*.html",
      "privacidade-v4*.html",
      "plano-urbano-visualizar.html",
      "*.py",
      "*.svg",
      "testes/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/contact-8{,/**}",
        "destination": "/#proposta",
        "type": 301
      },
      {
        "source": "/book-online{,/**}",
        "destination": "/#agenda",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}